  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:reset": "tsx prisma/seed.ts --reset",
    "db:seed:pdf": "tsx prisma/generate-seed-pdf.ts",
    "seed:api": "tsx prisma/seed-api.ts",
    "test": "vitest run test/unit",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/backend-qa.spec.ts --hookTimeout=30000 --testTimeout=30000",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@nestjs/common": "^12.0.1",
